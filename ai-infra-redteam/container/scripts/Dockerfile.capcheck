# Minimal image used to inspect capability sets and device visibility
# for the flag-comparison experiments in this project.
FROM debian:stable-slim
RUN apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends libcap2-bin util-linux pciutils procps curl netcat-traditional \
    && rm -rf /var/lib/apt/lists/*
CMD ["sleep", "infinity"]
