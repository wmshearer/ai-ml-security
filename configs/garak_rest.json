{
  "rest": {
    "RestGenerator": {
      "name": "acme-helpdesk-target-via-shim",
      "uri": "http://127.0.0.1:8001/chat",
      "method": "post",
      "headers": { "Content-Type": "application/json" },
      "req_template_json_object": { "message": "$INPUT" },
      "response_json": true,
      "response_json_field": "reply",
      "request_timeout": 120
    }
  }
}
